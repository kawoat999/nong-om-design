      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Extract data from webhook\nconst { user_id, type, image_base64 } = $input.item.json;\n\nreturn {\n  user_id: user_id || 'unknown',\n  type: type || 'expense',\n  image_base64: image_base64\n};"
      },
      "id": "edit-fields-1",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $credentials.apiKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"วิเคราะห์รูปสลิป/ใบเสร็จนี้ ตอบเป็น JSON เท่านั้น (ไม่ต้องมี markdown):\\n{\\n  \\\"amount\\\": จำนวนเงิน (ตัวเลข),\\n  \\\"date\\\": \\\"YYYY-MM-DD\\\",\\n  \\\"items\\\": [\\\"รายการ1\\\", \\\"รายการ2\\\"],\\n  \\\"suggested_category\\\": 1-8\\n}\\n\\nหมวดหมู่: 1=อาหาร, 2=เดินทาง, 3=บันเทิง, 4=สุขภาพ, 5=สมาชิกรายเดือน, 6=ของใช้จำเป็น, 7=ลงทุน, 8=อื่นๆ\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"image/jpeg\",\n            \"data\": \"{{ $json.image_base64 }}\"\n          }\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "gemini-1",
      "name": "Gemini Vision",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "credentials": {
        "httpQueryAuth": {
          "id": "gemini-api",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse Gemini response\nconst response = $input.item.json;\nconst user_id = $('Edit Fields').item.json.user_id;\nconst type = $('Edit Fields').item.json.type;\n\ntry {\n  // Extract text from Gemini response\n  const text = response.candidates[0].content.parts[0].text;\n  \n  // Clean and parse JSON\n  const cleanText = text.replace(/```json\\n?|```\\n?/g, '').trim();\n  const data = JSON.parse(cleanText);\n  \n  // Category names for reference\n  const categories = {\n    1: 'Food',\n    2: 'Transport', \n    3: 'Entertainment',\n    4: 'Health',\n    5: 'Subscriptions',\n    6: 'Necessities',\n    7: 'Investment',\n    8: 'Others'\n  };\n  \n  return {\n    success: true,\n    user_id: user_id,\n    type: type,\n    amount: data.amount || 0,\n    date: data.date || new Date().toISOString().split('T')[0],\n    description: (data.items || []).join(', '),\n    category_id: data.suggested_category || 8,\n    category_name: categories[data.suggested_category] || 'Others',\n    source: 'ocr',\n    needs_confirmation: true\n  };\n} catch (error) {\n  return {\n    success: false,\n    error: 'ไม่สามารถอ่านข้อมูลจากรูปได้',\n    user_id: user_id,\n    type: type\n  };\n}"
      },
      "id": "parse-response",
      "name": "Parse Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 0]
    },
